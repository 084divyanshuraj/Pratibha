# ==============================================================================
# Smart Campus Analytics Backend — Environment Configuration
# Copy this file to .env inside backend/ for local development.
# NEVER commit real .env files with credentials to version control.
# ==============================================================================

# Application & Runtime
NODE_ENV=development
PORT=5000

# Database Configuration (MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database_name>?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated for multiple origins)
# Example for local development: http://localhost:3000,http://localhost:5173
# In production, set to your Vercel frontend URL: https://<frontend-app>.vercel.app
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# ML Inference Microservice (Python FastAPI deployed on Render)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=optional_shared_secret_if_configured
ML_TIMEOUT_MS=5000

# Logging
LOG_LEVEL=info

# Optional AI Copilot Assistant (Leave false to run in deterministic safe mode)
COPILOT_ENABLED=false
COPILOT_PROVIDER=none
COPILOT_API_KEY=optional_api_key_when_configured
